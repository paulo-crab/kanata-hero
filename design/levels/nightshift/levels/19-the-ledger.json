          {
            "id": "declare",
            "player_confirm": "Practice layer: player-confirmed on / unconfirmed"
          },
          {
            "id": "q-leave",
            "question": "How do you leave practice?",
            "answer": "press the same real Control + Alt + GUI + V again"
          },
          {
            "id": "q-reload",
            "question": "How do you reload Kanata?",
            "answer": "Control + Shift + R: tap-hold A, tap-hold J, then R (operations card, not performed here)"
          },
          {
            "id": "q-last",
            "question": "What does the last resort cost?",
            "answer": "it quits Kanata; remapping stays off until Kanata is restarted"
          }
        ],
        "accepts": [
          "all three answers"
        ],
        "rejects": [
          "asking the player to press the reload or emergency keys here"
        ],
        "feedback": {
          "wrong": "The emergency exit quits Kanata and is not a layer toggle; the toggle on the exit card is the way back."
        }
      }
    },
