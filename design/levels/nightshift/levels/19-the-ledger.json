{
  "id": "nightshift-19",
  "number": 19,
  "title": "The Ledger",
  "district": "nightshift",
  "kind": "review",
  "requires": [
    "nightshift-18"
  ],
  "story": "The northern ledger holds raw tickets that Pace never included in its reports; the margins show staff proposed shorter routes long before the system did. The engineer re-runs every held-Space output under player-confirmed practice. When the ledger is correct, the break room window glows and the corridor wakes.",
  "steps": [
    {
      "id": "s19-1",
      "objective": "Walk through the open north stair door into the ledger room.",
      "interaction": "int-door-stair",
      "completes_when": "reach_cell:18,5"
    },
    {
      "id": "s19-2",
      "objective": "Answer the check-in questions at the ledger noticeboard.",
      "interaction": "int-ledger-card",
      "completes_when": "scene_success:n19-t0-ledger-checkin"
    },
    {
      "id": "s19-3",
      "objective": "Re-run the held-Space outputs at the ledger desk.",
      "interaction": "int-ledger-desk",
      "completes_when": "scene_success:n19-t1-ledger-guided-rerun"
    },
    {
      "id": "s19-4",
      "objective": "Copy the mixed records from the raw ticket cabinet.",
      "interaction": "int-ledger-cabinet",
      "completes_when": "scene_success:n19-t2-mixed-records"
    },
    {
      "id": "s19-5",
      "objective": "Recall the shuffled records at the archive shelf, with no diagram.",
      "interaction": "int-ledger-shelf",
      "completes_when": "scene_success:n19-t3-shuffled-ledger-recall"
    },
    {
      "id": "s19-6",
      "objective": "Make the final correction at the ledger terminal.",
      "interaction": "int-ledger-final",
      "completes_when": "scene_success:n19-t4-final-correction"
    },
    {
      "id": "s19-7",
      "objective": "Read Ada's shift book on the ledger desk.",
      "interaction": "int-artifact-shift-book",
      "completes_when": "interact:int-artifact-shift-book",
      "optional": true
    },
    {
      "id": "s19-8",
      "objective": "Walk back through the lit service corridor to the break room.",
      "interaction": "int-door-service",
      "completes_when": "reach_cell:30,13",
      "target_cell": [
        30,
        13
      ]
    }
  ],
