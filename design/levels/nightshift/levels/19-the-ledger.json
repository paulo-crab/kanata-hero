    {
      "id": "n19-t0-ledger-checkin",
      "kind": "keypad",
      "task_summary": "Ledger check-in: declare the practice state again and answer the operations-card questions from memory (reload, toggle, last resort).",
      "success_criteria": [
        "The player declares the practice state without a key diagram (on request only).",
        "The player answers three card questions: how to leave practice, how to reload, and what the last resort costs.",
        "Both declarations open the ledger; unconfirmed runs are labelled output-observed in the journal."
      ],
      "retry": "instant",
      "position_cue": false,
      "confidence": "external-only",
      "task": {
        "prompt": "The ledger asks the same three things Ada asked, with no diagram.",
