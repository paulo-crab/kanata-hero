{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "layout-manifest.schema.json",
  "title": "Kanata Hero layout manifest",
  "description": "Machine-readable form of ~/.config/kanata/kanata.kbd for the game: the four layers, every physical key with its per-layer behaviour, the global sequences, the keyboards, and every gesture-inventory row linked to the keys, observed output, verification method and lessons. Generated by generate_manifest.py; never hand-edited. Fields are explained in README.md.",
  "x-schema-version": "1.0",
  "type": "object",
  "required": ["schema_version", "manifest_version", "generated", "generator", "source", "scope", "assumptions", "variables", "hands", "timings", "layers", "keyboards", "outputs", "keys", "sequences", "practice", "reserved_keys", "inventory"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "manifest_version": {"type": "string", "pattern": "^1\\.0\\+[0-9a-f]{8}$", "description": "schema version plus the first 8 hex digits of the source sha256"},
    "generated": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "generator": {"type": "string"},
    "source": {
      "type": "object", "required": ["path", "sha256", "lines", "process_unmapped_keys"], "additionalProperties": false,
      "properties": {
        "path": {"const": "~/.config/kanata/kanata.kbd"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "lines": {"type": "integer", "minimum": 1},
        "process_unmapped_keys": {"type": "boolean"},
        "kanata": {"type": "object", "properties": {"version": {"type": ["string", "null"]}, "revision": {"type": ["string", "null"]}, "from": {"type": "string"}}, "additionalProperties": false}
      }
    },
    "scope": {"type": "object", "required": ["in", "excluded", "swedish_keys"], "additionalProperties": false,
      "properties": {"in": {"type": "array", "items": {"type": "string"}}, "excluded": {"type": "string"}, "swedish_keys": {"type": "array", "items": {"type": "string"}}}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "variables": {"type": "object"},
    "hands": {"type": "object", "required": ["left", "right"], "additionalProperties": false,
      "properties": {"left": {"type": "array", "items": {"type": "string"}}, "right": {"type": "array", "items": {"type": "string"}}}},
    "timings": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "kanata", "tap_timeout_ms", "hold_ms", "keys", "meaning"], "additionalProperties": false,
      "properties": {"id": {"type": "string"}, "kanata": {"type": "string"}, "tap_timeout_ms": {"type": "integer"}, "hold_ms": {"type": "integer", "minimum": 1}, "keys": {"type": "array", "items": {"type": "string"}}, "meaning": {"type": "string"}}}},
    "layers": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/layer"}},
    "keyboards": {"type": "object", "required": ["default", "macbook", "microsoft"], "additionalProperties": false,
      "properties": {"default": {"const": "macbook"}, "macbook": {"$ref": "#/$defs/keyboard"}, "microsoft": {"$ref": "#/$defs/keyboard"}}},
    "outputs": {"type": "object", "description": "browser-facing description of every output name used by the keys", "additionalProperties": {"$ref": "#/$defs/output_event"}},
    "keys": {"type": "array", "minItems": 60, "items": {"$ref": "#/$defs/key"}},
    "sequences": {"type": "array", "minItems": 3, "items": {"type": "object", "required": ["id", "label", "verification"], "properties": {
      "id": {"enum": ["violento-toggle", "reload-config", "emergency-exit"]}, "label": {"type": "string"}, "verification": {"$ref": "#/$defs/verification"},
      "status": {"enum": ["present_unverified"]}, "defined_in_config": {"type": "boolean"}, "source_line": {"type": ["integer", "null"]}}}},
    "practice": {"type": "object", "required": ["silenced_keys", "note"], "additionalProperties": false,
      "properties": {"silenced_keys": {"type": "array", "items": {"type": "string"}}, "note": {"type": "string"}}},
    "reserved_keys": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["character", "key", "role"], "properties": {"character": {"type": "string"}, "key": {"type": "string"}, "role": {"type": "string"}, "passthrough_on": {"type": "array", "items": {"$ref": "#/$defs/layer_id"}}, "gesture": {"type": "string"}}}},
    "inventory": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/inventory_row"}}
  },
  "$defs": {
    "layer_id": {"enum": ["base", "nav", "numbers-symbols", "practice"]},
    "verification": {"enum": ["observed", "player_confirmed", "external_only"]},
    "flag": {"enum": ["ctrlKey", "altKey", "metaKey", "shiftKey"]},
    "output_event": {"type": "object", "required": ["label", "event_key", "event_code", "event_flags"], "additionalProperties": false,
      "properties": {"label": {"type": "string"}, "event_key": {"type": "string"}, "event_code": {"type": "string"}, "event_flags": {"type": "array", "items": {"$ref": "#/$defs/flag"}}, "typed": {"type": "string"}}},
    "output": {"type": "object", "required": ["kanata", "label"], "additionalProperties": false,
      "properties": {"kanata": {"type": "string"}, "label": {"type": "string"}, "shift_retained": {"type": "boolean"}, "external": {"type": "boolean"}}},
    "hold": {"type": "object", "required": ["kind"], "additionalProperties": false,
      "properties": {"kind": {"enum": ["modifier", "layer", "macro"]}, "output": {"$ref": "#/$defs/output"}, "label": {"type": "string"}, "layer": {"$ref": "#/$defs/layer_id"},
        "also_outputs": {"type": "array", "items": {"$ref": "#/$defs/output"}}, "external": {"type": "boolean"}, "after_ms": {"type": ["integer", "null"]}}},
    "timing": {"type": "object", "required": ["variant", "tap_timeout_ms", "hold_ms"], "additionalProperties": false,
      "properties": {"variant": {"enum": ["tap-hold", "tap-hold-press", "tap-hold-tap-keys"]}, "tap_timeout_ms": {"type": "integer"}, "hold_ms": {"type": "integer"},
        "same_hand_rolls_type_the_tap": {"type": "boolean"}, "trigger_hand": {"enum": ["left", "right", null]}, "require_prior_idle_ms": {"type": "integer"},
        "hold_starts_when_another_key_is_pressed": {"type": "boolean"}}},
    "chord": {"type": "object", "required": ["kind", "when", "uses_physical_input", "line"], "additionalProperties": false,
      "properties": {"kind": {"enum": ["reload", "layer-switch"]}, "target": {"type": ["string", "null"]}, "when": {"type": "array"}, "uses_physical_input": {"type": "boolean"}, "line": {"type": "integer"}}},
    "exception": {"type": "object", "required": ["when", "does"], "additionalProperties": false,
      "properties": {"when": {"type": "string"}, "does": {"type": "string"}, "scope": {"const": "swedish"}}},
    "variant": {"type": "object", "required": ["behaviour"], "properties": {"behaviour": {"enum": ["plain", "tap-hold", "layer-hold", "silent", "inherits"]}, "tap": {"$ref": "#/$defs/output"}, "hold": {"$ref": "#/$defs/hold"}, "alias": {"type": "string"}, "timing": {"$ref": "#/$defs/timing"}, "legend": {"type": "string"}}},
    "layer_entry": {"type": "object", "required": ["behaviour", "explicit"], "additionalProperties": false,
      "properties": {
        "behaviour": {"enum": ["plain", "tap-hold", "layer-hold", "silent", "passthrough", "inherits"]},
        "explicit": {"type": "boolean"}, "alias": {"type": "string"}, "line": {"type": "integer"}, "contextual": {"type": "boolean"},
        "tap": {"$ref": "#/$defs/output"}, "hold": {"$ref": "#/$defs/hold"}, "timing": {"$ref": "#/$defs/timing"},
        "legend": {"type": "string"}, "chord": {"$ref": "#/$defs/chord"}, "requires_physical": {"type": "string"},
        "exceptions": {"type": "array", "items": {"$ref": "#/$defs/exception"}},
        "device_variants": {"type": "object", "additionalProperties": {"$ref": "#/$defs/variant"}},
        "shift_variant": {"type": "string"},
        "falls_to": {"type": "array", "items": {"$ref": "#/$defs/layer_id"}},
        "differs_from_base": {"type": "boolean"}, "retained_from_base": {"type": "boolean"}}},
    "key": {"type": "object", "required": ["id", "kanata", "position", "keyboards", "label", "hand", "in_defsrc", "layers"], "additionalProperties": false,
      "properties": {
        "id": {"type": "string"}, "kanata": {"type": ["string", "null"]}, "label": {"type": "string"}, "hand": {"enum": ["left", "right", null]},
        "in_defsrc": {"type": "boolean"}, "reach": {"type": "string"},
        "keyboards": {"type": "array", "items": {"enum": ["macbook", "microsoft"]}, "minItems": 1},
        "position": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["row", "column", "x_u", "width_u"], "additionalProperties": false,
          "properties": {"row": {"type": "integer", "minimum": 0, "maximum": 5}, "column": {"type": "integer", "minimum": 0}, "x_u": {"type": "number", "minimum": 0}, "width_u": {"type": "number", "exclusiveMinimum": 0},
            "height_u": {"type": "number"}, "stack": {"enum": ["upper", "lower"]}}}]},
        "layers": {"type": "object", "required": ["base", "nav", "numbers-symbols", "practice"], "additionalProperties": false,
          "properties": {"base": {"$ref": "#/$defs/layer_entry"}, "nav": {"$ref": "#/$defs/layer_entry"}, "numbers-symbols": {"$ref": "#/$defs/layer_entry"}, "practice": {"$ref": "#/$defs/layer_entry"}}}}},
    "layer": {"type": "object", "required": ["id", "title", "kanata_layer", "kind", "entry", "activated_by"], "additionalProperties": false,
      "properties": {"id": {"$ref": "#/$defs/layer_id"}, "title": {"type": "string"}, "kanata_layer": {"type": "string"}, "kind": {"enum": ["default", "while-held", "toggle"]},
        "entry": {"type": "string"}, "exit": {"type": "string"},
        "activated_by": {"type": "array", "items": {"type": "object", "required": ["key", "keyboard", "scope"], "properties": {"key": {"type": "string"}, "keyboard": {"enum": ["macbook", "microsoft", "both"]}, "after_ms": {"type": ["integer", "null"]}, "scope": {"enum": ["full", "partial"]}, "sequence": {"type": "string"}, "starts_on_next_key": {"type": "boolean"}}}}}},
    "keyboard": {"type": "object", "required": ["label", "bottom_row", "remap"], "additionalProperties": false,
      "properties": {"label": {"type": "string"}, "note": {"type": "string"}, "device": {"type": ["object", "null"]},
        "bottom_row": {"type": "array", "items": {"type": "object", "required": ["id", "source", "width_u"], "additionalProperties": false, "properties": {"id": {"type": "string"}, "source": {"type": ["string", "null"]}, "width_u": {"type": "number"}}}},
        "remap": {"type": "array", "items": {"type": "object", "required": ["physical", "source", "emits", "label", "legend"], "additionalProperties": false,
          "properties": {"physical": {"type": "string"}, "source": {"type": "string"}, "emits": {"type": "string"}, "label": {"type": "string"}, "legend": {"type": "string"}, "also": {"type": "string"}}}}}},
    "inventory_row": {"type": "object", "required": ["id", "group", "layer", "input", "output", "lessons", "verification", "links", "sequences", "observed"], "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^(B(0[1-9]|1[0-5])|N(0[1-9]|1[0-9]|2[01])|S(0[1-9]|1[0-9]|2[0-6])|V0[1-6])$"},
        "group": {"type": "string"}, "layer": {"$ref": "#/$defs/layer_id"}, "input": {"type": "string"}, "output": {"type": "string"},
        "lessons": {"type": "object", "required": ["introduced", "reviewed", "all"], "additionalProperties": false,
          "properties": {"introduced": {"type": "integer", "minimum": 1, "maximum": 20}, "reviewed": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 20}}, "all": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1, "maximum": 20}}}},
        "verification": {"$ref": "#/$defs/verification"},
        "links": {"type": "array", "items": {"type": "object", "required": ["key", "layer", "role"], "additionalProperties": false,
          "properties": {"key": {"type": "string"}, "layer": {"$ref": "#/$defs/layer_id"}, "role": {"enum": ["output", "hold", "layer-key", "silenced", "context"]}, "expect": {"type": "object"}}}},
        "sequences": {"type": "array", "items": {"enum": ["violento-toggle", "reload-config", "emergency-exit"]}},
        "observed": {"type": "object", "required": ["rule", "events"], "additionalProperties": false,
          "properties": {"rule": {"type": "string", "minLength": 20}, "events": {"type": "array", "items": {"type": "object", "required": ["key", "code", "flags", "source", "layer"], "properties": {"key": {"type": "string"}, "code": {"type": "string"}, "flags": {"type": "array", "items": {"$ref": "#/$defs/flag"}}, "source": {"type": "string"}, "layer": {"$ref": "#/$defs/layer_id"}, "after_ms": {"type": ["integer", "null"]}, "side_effect": {"type": "boolean"}}}}}}}}
  }
}
